# Copy this file to .env and fill in real values — never commit .env

# Target environment: qa | preprod | prod  (default: qa)
TARGET_ENV=qa

# Optional base URL overrides (else loaded from config/environments/*.ts)
# WEB_BASE_URL=https://myaccount-ui.qa.cinchhs.com
# API_BASE_URL=https://myaccount-ui.qa.cinchhs.com

# Data source: mongo (MyAccount test data)
DATA_SOURCE=mongo

# MongoDB (MyAccount test data — appdev_customer.{TARGET_ENV}_ui)
# Collection auto-derives from TARGET_ENV unless overridden:
#   qa      -> qa_ui
#   preprod -> preprod_ui
#   prod    -> prod_ui
MONGO_URI=mongodb://acceladmin:<password>@automationdb.qa.accelerate.cinchhs.com:27017/?authSource=admin
MONGO_DB=appdev_customer
# MONGO_COLLECTION=qa_ui
MONGO_SAMPLE_SUITE_ID=C171750

# Test credentials (used for login flows when not provided via MongoDB)
TEST_USER=your-app-login-email@example.com
TEST_PASS=your-app-password-here
# TEST_CARD_NUMBER=
# TEST_CARD_EXPIRY=
# TEST_CARD_CVV=
# TEST_CARD_FIRST_NAME=
# TEST_CARD_LAST_NAME=

# Execution
# PW_HEADED=1          # run with visible browser
# PW_SLOW_MO=120       # slow-motion delay (ms)
# PW_WORKERS=4         # parallel workers

# CI / tag filtering (@smoke | @regression | @e2e | @critical | @integration)
# PLAYWRIGHT_TAG=@smoke

# TLS (corporate proxy / SSL inspection)
# PW_IGNORE_HTTPS_ERRORS=1

# UI helper timeouts (utils/playwright-helper). EXPLICIT_WAIT_MS overrides EXPLICIT_WAIT_SECONDS when both are set.
# EXPLICIT_WAIT_SECONDS=15
# EXPLICIT_WAIT_MS=15000

# API auth (only if API tests are added; use CI secrets — never commit real values)
# API_BEARER_TOKEN=
# API_BASIC_USER=
# API_BASIC_PASS=

# Logging
# LOG_LEVEL=debug

# TestRail credentials (for AI-assisted test creation)
# Each team member should add their own credentials
Testrail_Username=your-email@cchs.com
Testrail_Password=your-password
